                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "const m = pm.response.json();",
                  "pm.test(\"un solo SPEI_ENVIADO\", () => pm.expect(m.filter(x => x.tipo === \"SPEI_ENVIADO\").length).to.eql(1));",
                  "pm.test(\"los movimientos suman el saldo (750)\", () => pm.expect(m.reduce((s, x) => s + Number(x.monto), 0)).to.eql(750));"
                ]

    {
      "name": "1 · Arriba y respondiendo",
      "description": "Parte 1 del lab: el sistema responde y abres tu primera cuenta.",
      "item": [
        {
          "name": "Salud de la app",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Abrir cuenta origen (1000)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cuentas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cuentas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clabe\": \"{{origen}}\",\n  \"titular\": \"Ana\",\n  \"saldoInicial\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// CLABEs y clave de idempotencia nuevas en cada corrida: así la colección se puede correr",
                  "// muchas veces sobre la misma base sin chocar con cuentas que ya existen (409).",
                  "const sello = String(Date.now()).slice(-12);",
                  "pm.collectionVariables.set(\"origen\", \"002180\" + sello);",
                  "pm.collectionVariables.set(\"destino\", \"012180\" + sello);",
                  "pm.collectionVariables.set(\"idempotencyKey\", \"prueba-\" + sello);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"saldo 1000\", () => pm.expect(Number(pm.response.json().saldo)).to.eql(1000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar cuenta origen",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cuentas/{{origen}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cuentas",
                "{{origen}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"saldo 1000\", () => pm.expect(Number(pm.response.json().saldo)).to.eql(1000));"
                ]
              }
            }
          ]
        }
      ]
    },

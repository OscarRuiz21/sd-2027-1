# ==============================================================================
# Etapa 1: Compilación y empaquetado del cliente (Maven + JDK 21)
# ==============================================================================
FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /app

# Copiar descriptor de dependencias
COPY pom.xml .

# Descargar dependencias para aprovechar caché de Docker
RUN mvn dependency:go-offline -B || true

# Copiar contrato proto y código fuente
COPY src ./src

# Compilar contratos protobuf, clases de dominio, cliente y resolver dependencias
RUN mvn clean package -DskipTests

# ==============================================================================
# Etapa 2: Runtime liviano del cliente (JRE 21)
# ==============================================================================
FROM eclipse-temurin:21-jre
WORKDIR /app

# Copiar las clases compiladas y todas las dependencias
COPY --from=builder /app/target/classes /app/classes
COPY --from=builder /app/target/dependency /app/dependency

# Variables de entorno predeterminadas para resolución en red Docker
ENV SERVER_HOST=server
ENV REST_PORT=8080
ENV GRPC_PORT=50051

# Ejecutar el cliente de benchmark y validación automatizada
ENTRYPOINT ["java", "-cp", "/app/classes:/app/dependency/*", "com.distribuidos.client.BenchmarkClient"]

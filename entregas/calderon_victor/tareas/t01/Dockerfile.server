# ==============================================================================
# Etapa 1: Compilación y empaquetado (Maven + JDK 21 glibc)
# ==============================================================================
FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /app

# Copiar descriptor de dependencias
COPY pom.xml .

# Descargar dependencias para aprovechar la caché de capas de Docker
RUN mvn dependency:go-offline -B || true

# Copiar el contrato protobuf y el código fuente
COPY src ./src

# Compilar contratos proto, generar código Java y empaquetar el JAR ejecutable
RUN mvn clean package -DskipTests

# ==============================================================================
# Etapa 2: Runtime liviano (JRE 21)
# ==============================================================================
FROM eclipse-temurin:21-jre
WORKDIR /app

# Instalar curl para healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Copiar el fat-jar generado desde la etapa de compilación
COPY --from=builder /app/target/t01-rest-grpc-1.0.0.jar app.jar

# Exponer puertos del servicio:
# 8080  -> REST (HTTP/1.1 + JSON)
# 50051 -> gRPC (HTTP/2 + Protobuf)
EXPOSE 8080 50051

# Ejecutar el servidor Spring Boot
ENTRYPOINT ["java", "-jar", "app.jar"]
